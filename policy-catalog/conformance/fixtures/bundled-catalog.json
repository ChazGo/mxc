      "tools": ["git", "node"],
      "context": { "platform": "linux", "architecture": "x64", "allowWeakIdentityFallback": true, "projectRoot": "/opt", "symbols": { "git_prefix": "/usr/bin", "node_prefix": "/opt/node" } },
