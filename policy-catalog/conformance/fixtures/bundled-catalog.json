    {
      "name": "empty input array produces no policy and no per-input records",
      "tools": [],
      "context": { "platform": "linux", "architecture": "x64" },
      "expect": {
        "policy": null,
        "diagnostics": { "catalogRevision": "2026-09-29.1", "tools": [], "resolvedDependencies": [], "warnings": [] }
      }
    },
    {
      "name": "unresolved required symbol prevents policy output, with diagnostics",
      "tools": "git",
      "context": { "platform": "linux", "architecture": "x64", "allowWeakIdentityFallback": true, "symbols": { "git_prefix": "/usr/bin" } },
      "expect": {
        "policy": null,
        "diagnostics": {
          "catalogRevision": "2026-09-29.1",
          "tools": [
            { "inputIndex": 0, "matches": [{ "entryId": "tool:git", "entryRevision": 1, "matchedIdentities": [{ "kind": "invocation-name", "strength": "weak" }] }] }
          ],
          "resolvedDependencies": [],
          "warnings": [
            "input 0 ('git') matched tool:git only by invocation name (weak identity)",
