{
  "$comment": "Language-neutral conformance cases against the bundled catalog. Every language binding (TypeScript, Rust, C#) must produce the same `expect` for each case from resolveSandboxPolicyWithDiagnostics(tools, context), and resolveSandboxPolicy must return `expect.policy`. `policy: null` is the language's absence value (undefined / None / null). `expectError` is the failure's MXC error `code` and stable `details.reason`. `tools` is a single input or an array.",
  "catalog": "bundled",
  "cases": [
    {
      "name": "git by string shorthand with weak fallback on windows",
      "tools": "git.exe",
      "context": {
        "platform": "windows",
        "architecture": "x64",
        "allowWeakIdentityFallback": true,
        "projectRoot": "C:\\work\\repo",
        "symbols": { "git_prefix": "C:\\Program Files\\Git\\cmd" }
      },
      "expect": {
        "policy": {
          "version": "0.9.0-alpha",
          "filesystem": {
            "readonlyPaths": ["C:\\Program Files\\Git\\cmd"],
            "readwritePaths": ["C:\\work\\repo"]
          }
        },
        "diagnostics": {
          "catalogRevision": "2026-09-29.1",
          "tools": [
            { "inputIndex": 0, "matches": [{ "entryId": "tool:git", "entryRevision": 1, "matchedIdentities": [{ "kind": "invocation-name", "strength": "weak" }] }] }
          ],
          "resolvedDependencies": [],
          "warnings": [
            "input 0 ('git.exe') matched tool:git only by invocation name (weak identity)",
            "tool:git uses its architecture-neutral windows variant; no x64-specific variant exists"
          ]
        }
      }
    },
    {
      "name": "node on linux with omitted architecture reports the native-architecture default",
      "tools": [{ "invocationName": "node" }],
      "context": { "platform": "linux", "allowWeakIdentityFallback": true, "symbols": { "node_prefix": "/usr/local/bin" } },
      "host": { "platform": "linux", "nativeArchitecture": "arm64" },
      "expect": {
        "policy": { "version": "0.9.0-alpha", "filesystem": { "readonlyPaths": ["/usr/local/bin"] } },
        "diagnostics": {
          "catalogRevision": "2026-09-29.1",
          "tools": [
            { "inputIndex": 0, "matches": [{ "entryId": "tool:node", "entryRevision": 1, "matchedIdentities": [{ "kind": "invocation-name", "strength": "weak" }] }] }
          ],
          "resolvedDependencies": [],
          "warnings": [
            "input 0 ('node') matched tool:node only by invocation name (weak identity)",
            "architecture was not specified; variants were selected for the native system architecture 'arm64'; the tool's architecture was not verified",
            "tool:node uses its architecture-neutral linux variant; no arm64-specific variant exists"
          ]
        }
      }
    },
    {
      "name": "npm by package URL composes the node dependency on macos, with both npm predicates attributed",
      "tools": { "invocationName": "npx", "packageUrl": "pkg:npm/npm@10.9.0" },
      "context": {
        "platform": "macos",
        "architecture": "arm64",
        "allowWeakIdentityFallback": true,
        "projectRoot": "/Users/dev/app/",
        "symbols": { "npm_prefix": "/opt/homebrew/bin", "npm_cache": "/Users/dev/.npm", "node_prefix": "/opt/homebrew/bin" }
      },
      "expect": {
        "policy": {
          "version": "0.9.0-alpha",
          "filesystem": {
            "readonlyPaths": ["/opt/homebrew/bin"],
            "readwritePaths": ["/Users/dev/app", "/Users/dev/.npm"]
          }
        },
        "diagnostics": {
          "catalogRevision": "2026-09-29.1",
          "tools": [
            {
              "inputIndex": 0,
              "matches": [{
                "entryId": "tool:npm",
                "entryRevision": 1,
                "matchedIdentities": [{ "kind": "purl", "strength": "strong" }, { "kind": "invocation-name", "strength": "weak" }]
              }]
            }
          ],
          "resolvedDependencies": [{ "entryId": "tool:node", "entryRevision": 1 }],
          "warnings": [
            "tool:npm uses its architecture-neutral macos variant; no arm64-specific variant exists",
            "tool:node uses its architecture-neutral macos variant; no arm64-specific variant exists"
          ]
        }
      }
    },
    {
      "name": "an array of tools composes once per entry: shared dependency and repeated input contribute once",
      "tools": ["git", "npm", "node", "npm"],
      "context": {
        "platform": "linux",
        "architecture": "x64",
        "allowWeakIdentityFallback": true,
        "projectRoot": "/w",
        "symbols": { "git_prefix": "/usr/bin", "npm_prefix": "/opt/node/bin", "npm_cache": "/home/u/.npm", "node_prefix": "/opt/node/bin" }
      },
      "expect": {
        "policy": {
          "version": "0.9.0-alpha",
          "filesystem": {
            "readonlyPaths": ["/usr/bin", "/opt/node/bin"],
            "readwritePaths": ["/w", "/home/u/.npm"]
          }
        },
        "diagnostics": {
          "catalogRevision": "2026-09-29.1",
          "tools": [
            { "inputIndex": 0, "matches": [{ "entryId": "tool:git", "entryRevision": 1, "matchedIdentities": [{ "kind": "invocation-name", "strength": "weak" }] }] },
            { "inputIndex": 1, "matches": [{ "entryId": "tool:npm", "entryRevision": 1, "matchedIdentities": [{ "kind": "invocation-name", "strength": "weak" }] }] },
            { "inputIndex": 2, "matches": [{ "entryId": "tool:node", "entryRevision": 1, "matchedIdentities": [{ "kind": "invocation-name", "strength": "weak" }] }] },
            { "inputIndex": 3, "matches": [{ "entryId": "tool:npm", "entryRevision": 1, "matchedIdentities": [{ "kind": "invocation-name", "strength": "weak" }] }] }
          ],
          "resolvedDependencies": [{ "entryId": "tool:node", "entryRevision": 1 }],
          "warnings": [
            "input 0 ('git') matched tool:git only by invocation name (weak identity)",
            "input 1 ('npm') matched tool:npm only by invocation name (weak identity)",
            "input 2 ('node') matched tool:node only by invocation name (weak identity)",
            "input 3 ('npm') matched tool:npm only by invocation name (weak identity)",
            "tool:git uses its architecture-neutral linux variant; no x64-specific variant exists",
            "tool:npm uses its architecture-neutral linux variant; no x64-specific variant exists",
            "tool:node uses its architecture-neutral linux variant; no x64-specific variant exists"
          ]
        }
      }
    },
    {
      "name": "known and unknown inputs: the known requirement composes and the unknown one is reported",
