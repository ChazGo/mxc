            "required symbol 'project_root' (needed by tool:git) is unresolved; supply ResolveContext.projectRoot; no policy was returned"
          ]
        }
      }
    },
    {
      "name": "unavailable explicit revision is an error, not a substitution",
      "tools": "git",
      "context": { "platform": "linux", "architecture": "x64", "catalogRevision": "2099-01-01.1" },
      "expectError": { "code": "backend_error", "reason": "revision_unavailable" }
    },
    {
      "name": "relative symbol value is rejected",
      "tools": "node",
