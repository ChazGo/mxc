<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>Microsoft.Mxc.PolicyCatalog.Cli</RootNamespace>
    <AssemblyName>policy-catalog</AssemblyName>
    <IsPackable>false</IsPackable>
    <!-- Run with `dotnet <path>/policy-catalog.dll`; no native apphost is needed. -->
    <UseAppHost>false</UseAppHost>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Microsoft.Mxc.PolicyCatalog\Microsoft.Mxc.PolicyCatalog.csproj" />
  </ItemGroup>

</Project>
