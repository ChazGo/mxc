<Project Sdk="Microsoft.NET.Sdk">

  <!-- Template only. scripts/dotnet-functional.mjs copies this project into a
       temporary consumer directory outside the repository and restores it
       against the packed Microsoft.Mxc.PolicyCatalog .nupkg from a local feed.
       It is deliberately not part of Microsoft.Mxc.PolicyCatalog.slnx and has
       no ProjectReference to the source tree. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <PolicyCatalogPackageVersion Condition="'$(PolicyCatalogPackageVersion)' == ''">0.0.0-prototype</PolicyCatalogPackageVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.0" />
    <PackageReference Include="Microsoft.Mxc.PolicyCatalog" Version="$(PolicyCatalogPackageVersion)" />
  </ItemGroup>

</Project>
