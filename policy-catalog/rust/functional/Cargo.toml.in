# Template for the temporary consumer crate built by scripts/rust-functional.mjs.
# @CRATE_PATH@ is replaced with the extracted .crate directory (outside the repository).
[package]
name = "policy-catalog-functional-consumer"
version = "0.0.0"
edition = "2021"
license = "MIT"
publish = false

# Standalone: never part of an enclosing workspace.
[workspace]

[dependencies]
mxc-policy-catalog = { path = "@CRATE_PATH@" }
