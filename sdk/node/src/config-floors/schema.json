{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mxc.dev/schemas/config-floor/v1",
  "title": "MXC Config Floor Catalog",
  "type": "object",
  "required": ["schemaVersion", "entries"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": "1" },
    "entries": {
      "type": "array",
      "items": { "$ref": "#/$defs/entry" }
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "required": ["tool", "identity", "sandboxPolicy"],
      "additionalProperties": false,
      "properties": {
        "tool": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "identity": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/identity" }
        },
        "requires": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "sandboxPolicy": { "$ref": "#/$defs/sandboxPolicy" }
      }
    },
    "identity": {
      "type": "object",
      "required": ["kind", "names"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "invocation-name" },
        "names": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "sandboxPolicy": {
      "type": "object",
      "required": ["version"],
      "additionalProperties": false,
      "properties": {
        "version": { "type": "string", "minLength": 1 },
        "filesystem": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "readonlyPaths": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            },
            "readwritePaths": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            }
          }
        },
        "network": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "allowOutbound": { "type": "boolean" },
            "allowLocalNetwork": { "type": "boolean" },
            "allowedHosts": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            }
          }
        },
        "ui": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "allowWindows": { "type": "boolean" },
            "clipboard": { "enum": ["none", "read", "write", "all"] },
            "allowInputInjection": { "type": "boolean" }
          }
        },
        "timeoutMs": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
